# Local dev (npm run dev): use .env.development for your local API URL.
# Production build (npm run build): use .env.production or your host env var for the live API URL.
# Do NOT point production at localhost.

VITE_API_BASE_URL=http://localhost:3001/api

# Firebase (Frontend Web SDK)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_VAPID_KEY=