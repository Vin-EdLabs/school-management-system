PORT=3001
NODE_ENV=development
JWT_SECRET=replace-with-strong-jwt-secret

# Set on VPS behind nginx/Caddy so Express + Socket.IO trust X-Forwarded-* headers
TRUST_PROXY=1

# PostgreSQL (use either DATABASE_URL or individual PG_* values)
DATABASE_URL=
PG_HOST=localhost
PG_PORT=5432
PG_USER=postgres
PG_PASSWORD=postgres
PG_DATABASE=school_management_system

# Web Push (VAPID) for Parent Portal closed-app notifications
# Generate once with: npx web-push generate-vapid-keys
VAPID_SUBJECT=mailto:support@scholarnerve.com
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# ID card QR verify links use each school's subdomain, e.g. https://rosagardens.scholarnerve.com/verify/...
PUBLIC_BASE_DOMAIN=scholarnerve.com

# SMTP — partner & admin transactional email
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=scholarnerve@gmail.com
SMTP_PASS=
SMTP_FROM=ScholarNerve Partners <scholarnerve@gmail.com>
# Logo & login links auto-detect from NODE_ENV + PUBLIC_BASE_DOMAIN (optional overrides below)
# PUBLIC_APP_URL=
# PARTNER_PORTAL_URL=

# Firebase Cloud Messaging (recommended for reliable Android push when app/phone sleeps)
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
# Keep line breaks escaped as \n when pasting private key into .env
FIREBASE_PRIVATE_KEY=

# Arkesel SMS Gateway (Ghana SMS v2)
ARKESEL_API_KEY=
ARKESEL_DEFAULT_SENDER_ID=SCHNerve
