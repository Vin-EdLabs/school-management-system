generator client {
  provider        = "prisma-client"
  output          = "../src/generated/prisma"
  previewFeatures = ["partialIndexes"]
}

datasource db {
  provider = "postgresql"
}

model academic_terms {
  id               Int                @id @default(autoincrement())
  academic_year_id Int?
  name             String
  start_date       DateTime?          @db.Date
  end_date         DateTime?          @db.Date
  is_active        Boolean?           @default(false)
  academic_years   academic_years?    @relation(fields: [academic_year_id], references: [id], onDelete: Restrict, onUpdate: NoAction)
  invoices         invoices[]
  student_balances student_balances[]

  @@index([academic_year_id], map: "idx_academic_terms_year")
}

model academic_years {
  id             Int              @id @default(autoincrement())
  year_label     String
  start_date     DateTime?        @db.Date
  end_date       DateTime?        @db.Date
  is_active      Boolean?         @default(false)
  academic_terms academic_terms[]

  @@index([is_active], map: "idx_academic_years_is_active")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model attendance {
  id              Int       @id @default(autoincrement())
  class_id        Int
  student_id      Int
  attendance_date DateTime  @db.Date
  status          String    @db.VarChar(20)
  marked_by       Int?
  notes           String?
  created_at      DateTime? @default(now()) @db.Timestamptz(6)
  updated_at      DateTime? @default(now()) @db.Timestamptz(6)
  classes         classes   @relation(fields: [class_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  users           users?    @relation(fields: [marked_by], references: [id], onUpdate: NoAction)
  students        students  @relation(fields: [student_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([student_id, attendance_date])
  @@index([class_id, attendance_date], map: "idx_attendance_class_date")
  @@index([attendance_date], map: "idx_attendance_date")
  @@index([student_id, attendance_date], map: "idx_attendance_student_date")
}

model audit_logs {
  id          Int       @id @default(autoincrement())
  user_id     Int?
  action      String
  message     String?
  target_type String?
  target_id   Int?
  created_at  DateTime? @default(now()) @db.Timestamptz(6)
  users       users?    @relation(fields: [user_id], references: [id], onUpdate: NoAction)

  @@index([created_at], map: "idx_audit_logs_created_at")
  @@index([target_type, target_id], map: "idx_audit_logs_target")
  @@index([user_id], map: "idx_audit_logs_user")
}

model blacklisted_tokens {
  id         Int       @id @default(autoincrement())
  token      String
  created_at DateTime? @default(now()) @db.Timestamptz(6)

  @@index([token], map: "idx_blacklisted_tokens_token")
}

model classes {
  id              Int               @id @default(autoincrement())
  created_at      DateTime?         @default(now()) @db.Timestamptz(6)
  max_class_size  Int               @default(30)
  level           String?
  stream          String?
  attendance      attendance[]
  exams           exams[]
  fee_structures  fee_structures[]
  schedules       schedules[]
  students        students[]
  subjects        subjects[]
  teacher_classes teacher_classes[]

  @@index([level], map: "idx_classes_level")
  @@index([stream], map: "idx_classes_stream")
}

model events {
  id            Int       @id @default(autoincrement())
  title         String
  date          DateTime  @db.Timestamptz(6)
  time          String?
  description   String?
  color         String?
  category      String?
  reminder      Boolean?  @default(false)
  reminder_time Int?
  location      String?
  created_at    DateTime? @default(now()) @db.Timestamptz(6)

  @@index([date], map: "idx_events_date")
}

model exam_types {
  id         Int       @id @default(autoincrement())
  name       String
  weight     Decimal?  @default(0) @db.Decimal
  created_by Int?
  created_at DateTime? @default(now()) @db.Timestamptz(6)
  exams      exams[]
}

model exams {
  id           Int         @id @default(autoincrement())
  exam_type_id Int?
  class_id     Int?
  subject_id   Int?
  term         String?
  exam_date    DateTime?   @db.Timestamptz(6)
  is_locked    Boolean?    @default(false)
  created_by   Int?
  created_at   DateTime?   @default(now()) @db.Timestamptz(6)
  max_score    Int?        @default(100)
  classes      classes?    @relation(fields: [class_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  exam_types   exam_types? @relation(fields: [exam_type_id], references: [id], onUpdate: NoAction)
  subjects     subjects?   @relation(fields: [subject_id], references: [id], onUpdate: NoAction)
  grades       grades[]
}

model expenses {
  id           Int       @id @default(autoincrement())
  amount       Decimal   @db.Decimal(12, 2)
  description  String?
  category     String?
  year         Int?
  created_at   DateTime? @default(now()) @db.Timestamptz(6)
  title        String?   @db.VarChar(255)
  payee_name   String?   @db.VarChar(255)
  payment_date DateTime? @default(dbgenerated("CURRENT_DATE")) @db.Date
  method       String?   @db.VarChar(50)
  purpose      String?
  notes        String?

  @@index([year], map: "idx_expenses_year")
}

model fee_items {
  id               Int             @id @default(autoincrement())
  fee_structure_id Int?
  code             String?
  description      String?
  amount           Decimal         @db.Decimal(12, 2)
  is_optional      Boolean?        @default(false)
  fee_structures   fee_structures? @relation(fields: [fee_structure_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  invoice_items    invoice_items[]

  @@index([fee_structure_id], map: "idx_fee_items_structure")
}

model fee_structures {
  id         Int         @id @default(autoincrement())
  name       String
  items      Json?
  term_id    Int?
  class_id   Int?
  created_at DateTime?   @default(now()) @db.Timestamptz(6)
  fee_items  fee_items[]
  classes    classes?    @relation(fields: [class_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  invoices   invoices[]
}

model grade_boundaries {
  id         Int       @id @default(autoincrement())
  grade      String
  min        Int
  max        Int
  school_id  Int?
  class_id   Int?
  created_by Int?
  created_at DateTime? @default(now()) @db.Timestamptz(6)
  updated_at DateTime? @default(now()) @db.Timestamptz(6)

  @@index([school_id, class_id], map: "idx_grade_boundaries_school_class")
}

model grades {
  id         Int       @id @default(autoincrement())
  exam_id    Int?
  student_id Int?
  score      Decimal?  @db.Decimal
  status     String?   @default("OK")
  remarks    String?
  created_by Int?
  updated_by Int?
  created_at DateTime? @default(now()) @db.Timestamptz(6)
  updated_at DateTime? @default(now()) @db.Timestamptz(6)
  exams      exams?    @relation(fields: [exam_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  students   students? @relation(fields: [student_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([exam_id, student_id], map: "grades_exam_student_uq")
}

model guardians {
  id                Int                 @id @default(autoincrement())
  name              String
  relationship      String?
  phone             String?
  email             String?
  created_at        DateTime?           @default(now()) @db.Timestamptz(6)
  student_guardians student_guardians[]
}

model income {
  id          Int       @id @default(autoincrement())
  amount      Decimal   @db.Decimal(12, 2)
  description String?
  year        Int?
  created_at  DateTime? @default(now()) @db.Timestamptz(6)
  source      String?   @db.VarChar(255)
  method      String?   @db.VarChar(50)
  received_by String?   @db.VarChar(255)
  date        DateTime? @default(dbgenerated("CURRENT_DATE")) @db.Date
  notes       String?

  @@index([year], map: "idx_income_year")
}

model invoice_items {
  id                  Int                   @id @default(autoincrement())
  invoice_id          Int?
  fee_item_id         Int?
  description         String?
  amount              Decimal               @db.Decimal(12, 2)
  created_at          DateTime?             @default(now()) @db.Timestamptz(6)
  fee_items           fee_items?            @relation(fields: [fee_item_id], references: [id], onUpdate: NoAction)
  invoices            invoices?             @relation(fields: [invoice_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  payment_allocations payment_allocations[]
}

model invoices {
  id               Int             @id @default(autoincrement())
  student_id       Int?
  fee_structure_id Int?
  term_id          Int?
  due_date         DateTime?       @db.Date
  status           String?         @default("open")
  total_amount     Decimal?        @default(0) @db.Decimal(12, 2)
  created_at       DateTime?       @default(now()) @db.Timestamptz(6)
  updated_at       DateTime?       @default(now()) @db.Timestamptz(6)
  invoice_items    invoice_items[]
  fee_structures   fee_structures? @relation(fields: [fee_structure_id], references: [id], onUpdate: NoAction)
  students         students?       @relation(fields: [student_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  academic_terms   academic_terms? @relation(fields: [term_id], references: [id], onDelete: Restrict, onUpdate: NoAction)
}

model migrations {
  id     Int      @id @default(autoincrement())
  name   String   @db.VarChar(255)
  run_on DateTime @db.Timestamp(6)
}

model notifications {
  id         Int       @id @default(autoincrement())
  user_id    Int?
  message    String
  level      String?   @default("info")
  is_read    Boolean?  @default(false)
  expires_at DateTime? @db.Timestamptz(6)
  created_at DateTime? @default(now()) @db.Timestamptz(6)
  users      users?    @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

model payment_allocations {
  id              Int            @id @default(autoincrement())
  payment_id      Int?
  invoice_item_id Int?
  amount          Decimal        @db.Decimal(12, 2)
  invoice_items   invoice_items? @relation(fields: [invoice_item_id], references: [id], onDelete: Restrict, onUpdate: NoAction)
  payments        payments?      @relation(fields: [payment_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

model payments {
  id                  Int                   @id @default(autoincrement())
  student_id          Int?
  amount              Decimal               @db.Decimal(12, 2)
  method              String?
  term_id             Int?
  created_at          DateTime?             @default(now()) @db.Timestamptz(6)
  payment_date        DateTime?             @db.Date
  notes               String?
  receipt_number      String?
  payment_allocations payment_allocations[]
  students            students?             @relation(fields: [student_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([student_id], map: "idx_payments_student")
  @@index([term_id], map: "idx_payments_term")
}

model payroll_bonuses {
  id              Int            @id @default(autoincrement())
  payroll_item_id Int?
  bonus_type      String         @db.VarChar(50)
  amount          Decimal        @default(0) @db.Decimal(12, 2)
  description     String?
  created_at      DateTime?      @default(now()) @db.Timestamptz(6)
  payroll_items   payroll_items? @relation(fields: [payroll_item_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

model payroll_deductions {
  id              Int            @id @default(autoincrement())
  payroll_item_id Int?
  deduction_type  String         @db.VarChar(100)
  amount          Decimal        @db.Decimal(12, 2)
  description     String?
  created_at      DateTime?      @default(now()) @db.Timestamptz(6)
  payroll_items   payroll_items? @relation(fields: [payroll_item_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

model payroll_items {
  id                 Int                  @id @default(autoincrement())
  payroll_run_id     Int?
  staff_id           Int?
  base_salary        Decimal              @db.Decimal(12, 2)
  deductions         Decimal?             @default(0) @db.Decimal(12, 2)
  bonuses            Decimal?             @default(0) @db.Decimal(12, 2)
  net_amount         Decimal              @db.Decimal(12, 2)
  status             String?              @default("pending") @db.VarChar(50)
  notes              String?
  created_at         DateTime?            @default(now()) @db.Timestamptz(6)
  updated_at         DateTime?            @default(now()) @db.Timestamptz(6)
  payroll_bonuses    payroll_bonuses[]
  payroll_deductions payroll_deductions[]
  payroll_runs       payroll_runs?        @relation(fields: [payroll_run_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  users              users?               @relation(fields: [staff_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  payroll_payments   payroll_payments[]

  @@index([payroll_run_id], map: "idx_payroll_items_run")
  @@index([staff_id], map: "idx_payroll_items_staff")
}

model payroll_payments {
  id               Int            @id @default(autoincrement())
  payroll_item_id  Int?
  staff_id         Int?
  amount           Decimal        @db.Decimal(12, 2)
  payment_method   String?        @default("bank_transfer") @db.VarChar(50)
  payment_date     DateTime       @db.Timestamptz(6)
  reference_number String?        @db.VarChar(100)
  created_at       DateTime?      @default(now()) @db.Timestamptz(6)
  updated_at       DateTime?      @default(now()) @db.Timestamptz(6)
  payroll_items    payroll_items? @relation(fields: [payroll_item_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  users            users?         @relation(fields: [staff_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([payment_date], map: "idx_payroll_payments_date")
  @@index([payroll_item_id], map: "idx_payroll_payments_item")
}

model payroll_reports {
  id             Int           @id @default(autoincrement())
  payroll_run_id Int?
  report_type    String?       @db.VarChar(50)
  total_staff    Int?
  total_paid     Decimal?      @db.Decimal(12, 2)
  generated_at   DateTime?     @default(now()) @db.Timestamptz(6)
  generated_by   Int?
  users          users?        @relation(fields: [generated_by], references: [id], onUpdate: NoAction)
  payroll_runs   payroll_runs? @relation(fields: [payroll_run_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

model payroll_runs {
  id              Int               @id @default(autoincrement())
  month_year      String            @unique @db.VarChar(10)
  status          String?           @default("draft") @db.VarChar(50)
  total_amount    Decimal?          @default(0) @db.Decimal(12, 2)
  processed_date  DateTime?         @db.Timestamptz(6)
  created_at      DateTime?         @default(now()) @db.Timestamptz(6)
  updated_at      DateTime?         @default(now()) @db.Timestamptz(6)
  payroll_items   payroll_items[]
  payroll_reports payroll_reports[]

  @@index([month_year], map: "idx_payroll_runs_month_year")
}

/// This table contains exclusion constraints and requires additional setup for migrations. Visit https://pris.ly/d/exclusion-constraints for more info.
model schedules {
  id          Int                       @id @default(autoincrement())
  class_id    Int?
  teacher_id  Int?
  day_of_week Int                       @default(1) @db.SmallInt
  start_time  DateTime?                 @db.Time(6)
  end_time    DateTime?                 @db.Time(6)
  room        String?
  subject     String?
  created_at  DateTime?                 @default(now()) @db.Timestamp(6)
  updated_at  DateTime?                 @default(now()) @db.Timestamp(6)
  time_range  Unsupported("tstzrange")? @default(dbgenerated("make_schedule_time_range((day_of_week)::integer, start_time, end_time)"))
  classes     classes?                  @relation(fields: [class_id], references: [id], onUpdate: NoAction)
  users       users?                    @relation(fields: [teacher_id], references: [id], onUpdate: NoAction)
}

model settings {
  key   String @id
  value Json?
}

model student_balances {
  id             Int             @id @default(autoincrement())
  student_id     Int?
  term_id        Int?
  arrears        Decimal?        @default(0) @db.Decimal(10, 2)
  credit_balance Decimal?        @default(0) @db.Decimal(10, 2)
  updated_at     DateTime?       @default(now()) @db.Timestamp(6)
  students       students?       @relation(fields: [student_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  academic_terms academic_terms? @relation(fields: [term_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([student_id, term_id])
}

model student_guardians {
  student_id      Int
  guardian_id     Int
  primary_contact Boolean?  @default(false)
  guardians       guardians @relation(fields: [guardian_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  students        students  @relation(fields: [student_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@id([student_id, guardian_id])
}

model students {
  id                Int                 @id @default(autoincrement())
  first_name        String
  last_name         String
  class_id          Int?
  status            String?             @default("active")
  created_at        DateTime?           @default(now()) @db.Timestamptz(6)
  admission_no      String?
  gender            String?
  date_of_birth     DateTime?           @db.Date
  nationality       String?
  guardian_name     String?
  guardian_contact  String?
  home_address      String?
  previous_school   String?
  notes             String?
  date_of_admission DateTime?           @db.Date
  attendance        attendance[]
  grades            grades[]
  invoices          invoices[]
  payments          payments[]
  student_balances  student_balances[]
  student_guardians student_guardians[]
  classes           classes?            @relation(fields: [class_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([class_id], map: "idx_students_class")
}

model subjects {
  id               Int                @id @default(autoincrement())
  name             String
  class_id         Int?
  teacher_id       Int?
  created_at       DateTime?          @default(now()) @db.Timestamptz(6)
  code             String?
  description      String?
  exams            exams[]
  classes          classes?           @relation(fields: [class_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  users            users?             @relation(fields: [teacher_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  teacher_subjects teacher_subjects[]
}

model teacher_classes {
  teacher_id Int
  class_id   Int
  classes    classes @relation(fields: [class_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  users      users   @relation(fields: [teacher_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@id([teacher_id, class_id])
}

model teacher_subjects {
  teacher_id Int
  subject_id Int
  subjects   subjects @relation(fields: [subject_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  users      users    @relation(fields: [teacher_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@id([teacher_id, subject_id])
}

model users {
  id                Int                @id @default(autoincrement())
  password_hash     String
  role              String             @default("staff")
  created_at        DateTime?          @default(now()) @db.Timestamptz(6)
  updated_at        DateTime?          @default(now()) @db.Timestamptz(6)
  email             String?
  display_name      String?
  password_changed  Boolean?           @default(false)
  staff_id          String?            @unique(map: "users_staff_id_unique", where: raw("((role = 'teacher'::text) AND (staff_id IS NOT NULL))")) @db.VarChar(50)
  phone             String?
  gender            String?
  date_of_birth     DateTime?          @db.Date
  address           String?
  employment_date   DateTime?          @db.Date
  employment_status String?            @default("Active")
  monthly_salary    Decimal?           @default(0) @db.Decimal(12, 2)
  notes             String?
  attendance        attendance[]
  audit_logs        audit_logs[]
  notifications     notifications[]
  payroll_items     payroll_items[]
  payroll_payments  payroll_payments[]
  payroll_reports   payroll_reports[]
  schedules         schedules[]
  subjects          subjects[]
  teacher_classes   teacher_classes[]
  teacher_subjects  teacher_subjects[]
}
